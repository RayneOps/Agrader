# Copy to .env and fill in. Never commit .env.

# --- Django ---
DJANGO_DEBUG=true
# Required when DJANGO_DEBUG=false. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Full origins, comma separated, e.g. https://app.example.org (production only)
DJANGO_CSRF_TRUSTED_ORIGINS=

# Leave empty for local SQLite. Production example:
#   DATABASE_URL=postgres://agrader:password@host:5432/agrader?sslmode=require
DATABASE_URL=
# true if DATABASE_URL goes through a transaction-mode pooler (PgBouncer, Neon -pooler, Supabase 6543)
DB_POOLED=false
# Seconds to keep database connections open. Keep 0 on serverless hosts.
DB_CONN_MAX_AGE=0
# prod_setup only: use DATABASE_URL_UNPOOLED (a direct connection) for migrations.
AGRADER_DIRECT_DB=false

# Logs go to stdout.
LOG_LEVEL=INFO

# Shown in the UI everywhere.
PRODUCT_NAME=AGRADER
# Email or phone shown on the public landing page. Leave empty to hide the Contact section.
PUBLIC_CONTACT=

# --- Initial super admin passwords, read by `manage.py seed_admins` ---
# At least 10 characters, not common, not all digits.
ADMIN_PW_USMAN=
ADMIN_PW_ISHAQ=
ADMIN_PW_SAMANTHA=
ADMIN_PW_APEH=
# The one admin who may approve crop rules (normally the Crop Scientist's account).
# Leave empty and nobody can approve. Re-run seed_admins after changing it.
RULE_APPROVER_EMAIL=

# --- Recommendation LLM (used from phase 6) ---
# gemini or claude
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Allow crop rules not yet approved by the Crop Scientist. Shows a banner on every recommendation.
ALLOW_UNAPPROVED_RULES=false
